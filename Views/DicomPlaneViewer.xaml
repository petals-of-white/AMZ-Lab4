<UserControl
    x:Class="Views.DicomPlaneViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:openTK="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
    xmlns:viewmodel="clr-namespace:ViewModels;assembly=ViewModels"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodel:DicomViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <viewmodel:PerfusionInfoViewModel x:Key="perfusionVM" />
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <openTK:GLWpfControl
            x:Name="openTkControl"
            Width="{Binding Series.Width}"
            Height="{Binding Series.Height}"
            d:Height="256"
            d:Width="256"
            Render="OpenTkControl_Render" />
        <StackPanel
            Width="240"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Label Content="{Binding DisplayedPlane}"/>
            <Label Content="Space" />
            <Slider
                Maximum="{Binding NumberOfSpacePositions}"
                Minimum="1"
                TickFrequency="1"
                TickPlacement="BottomRight"
                Value="{Binding CurrentSpaceSlice}" />
            <Label Content="Time" />
            <Slider
                Maximum="{Binding NumberOfTemporalPositions}"
                Minimum="1"
                TickFrequency="1"
                TickPlacement="BottomRight"
                Value="{Binding CurrentTimeSlice}" />
        </StackPanel>

        <StackPanel
            d:DataContext="{d:DesignInstance Type=viewmodel:PerfusionInfoViewModel}"
            DataContext="{Binding Source={StaticResource perfusionVM}}"
            Orientation="Vertical">
            <Rectangle
                Width="300"
                Height="200"
                Fill="Blue" />
            <TextBlock>
                <Run Text="{Binding Tta, StringFormat='TTA: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Baseline, StringFormat='Baseline: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Pe, StringFormat='PE: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Ttp, StringFormat='TTP: {0}'}" />
                <LineBreak />

                <Run Text="{Binding RTtp, StringFormat='rTTP: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Fwhm, StringFormat='FWHM: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Wir, StringFormat='WiR: {0}'}" />
                <LineBreak />

                <Run Text="{Binding Wor, StringFormat='WOR: {0}'}" />

            </TextBlock>
        </StackPanel>

    </StackPanel>
</UserControl>